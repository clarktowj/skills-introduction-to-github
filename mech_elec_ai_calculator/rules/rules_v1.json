{
    "version": "2.0",
    "description": "电气算量规则库 - 完善DXF识别规则 (强化版)",

    "reserve_lengths": {
        "cabinet": 1.5,
        "distribution_box": 0.8,
        "outdoor": 2.0,
        "vertical": 0.5,
        "elbow": 0.3,
        "manhole": 1.0,
        "equipment_terminal": 0.3,
        "cable_joint": 0.5
    },

    "correction_factors": {
        "cable_tray": 1.02,
        "pipe": 1.05,
        "wall": 1.03,
        "ceiling": 1.02,
        "direct_burial": 1.08,
        "trunking": 1.02,
        "unknown": 1.03
    },

    "device_classification": {
        "cabinet": {
            "device_type": "cabinet",
            "priority": 1,
            "confidence_threshold": 0.7,
            "keywords": [
                "配电柜", "开关柜", "控制柜", "进线柜", "出线柜",
                "MCC", "GGD", "GCS", "GCK", "PGL",
                "XL-21", "XL21", "XL21柜",
                "低压柜", "高压柜", "中置柜", "环网柜",
                "AP柜", "AA柜", "AH柜",
                "Electrical Panel", "Switchgear", "Distribution Board"
            ],
            "name_patterns": [
                "P\\d{1,3}", "AP\\d{1,3}", "AA\\d{1,3}", "AH\\d{1,3}",
                "AL\\d{1,3}", "AT\\d{1,3}"
