        "switch": {
            "device_type": "switch",
            "priority": 2,
            "confidence_threshold": 0.6,
            "keywords": [
                "开关", "断路器", "空开", "隔离开关",
                "MCB", "RCCB", "RCBO", "MCCB", "ACB",
                "单极开关", "双极开关", "三极开关",
