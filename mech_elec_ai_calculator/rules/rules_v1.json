    "device_classification": {
        "distribution_box": {
            "device_type": "distribution_box",
            "keywords": ["配电箱", "接线箱", "端子箱", "控制箱", "分线盒", "AL", "AP", "ALE"],
            "priority": 1
        },
        "cabinet": {
            "device_type": "cabinet",
            "keywords": ["配电柜", "开关柜", "控制柜", "进线柜", "出线柜", "GCS", "GCK", "MNS"],
            "priority": 2
        },
        "equipment": {
            "device_type": "equipment",
            "keywords": ["设备", "电机", "变压器", "风机", "水泵", "空调", "机组"],
            "priority": 3
        },
        "switch": {
            "device_type": "switch",
            "keywords": ["开关", "断路器", "空开", "熔断器", "隔离开关"],
            "priority": 4
        },
        "socket": {
            "device_type": "socket",
            "keywords": ["插座", "插孔", "电源插座"],
            "priority": 5
