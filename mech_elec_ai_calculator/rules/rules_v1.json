        "socket": {
            "device_type": "socket",
            "priority": 3,
            "confidence_threshold": 0.5,
            "keywords": [
                "插座", "插孔", "电源插座",
                "单相插座", "三相插座",
                "五孔插座", "三孔插座", "两孔插座",
                "防水插座", "防爆插座",
                "Socket", "Outlet", "Receptacle",
                "插", "OUT"
            ],
            "name_patterns": [
                "XS\\d{1,3}", "X\\d{1,3}"
            ],
            "block_keywords": [
                "插座", "插", "sock", "outlet"
            ]
        },
        "lighting": {
            "device_type": "lighting",
            "priority": 3,
            "confidence_threshold": 0.5,
            "keywords": [
                "灯", "照明", "射灯", "吊灯", "筒灯", "日光灯", "荧光灯",
                "应急灯", "指示灯", "疏散指示灯", "安全出口灯",
                "吸顶灯", "壁灯", "台灯", "地脚灯",
                "Light", "Lamp", "Fixture", "Lighting"
            ],
            "name_patterns": [
                "L\\d{1,3}", "E\\d{1,3}", "EL\\d{1,3}"
            ],
            "block_keywords": [
                "灯", "light", "lamp", "照明"
            ]
        },
        "equipment": {
            "device_type": "equipment",
            "priority": 2,
            "confidence_threshold": 0.7,
            "keywords": [
                "设备", "电机", "马达", "电动机",
                "变压器", "风机", "水泵", "空调", "机组",
                "M", "Motor", "Pump", "Fan", "Chiller",
                "冷却塔", "空压机", "压缩机",
                "水泵房", "风机房", "机房设备"
            ],
            "name_patterns": [
                "M\\d{1,3}", "M-\\d{1,3}",
                "T\\d{1,3}", "TM\\d{1,3}",
                "YB\\d{1,3}", "Y\\d{1,3}"
            ],
            "block_keywords": [
                "M", "设备", "电机", "马达", "motor", "pump", "fan"
            ]
        },
        "meter": {
            "device_type": "other",
            "priority": 2,
            "confidence_threshold": 0.6,
            "keywords": [
                "电表", "电能表", "计量表", "电度表",
                "电流表", "电压表", "功率表",
                "Meter", "kWh", "CT", "PT"
            ],
            "name_patterns": [
                "PJ\\d{1,3}", "PA\\d{1,3}", "PV\\d{1,3}"
            ],
            "block_keywords": [
                "电表", "meter", "计量"
            ]
        },
        "other": {
            "device_type": "other",
            "priority": 99,
            "confidence_threshold": 0.3,
            "keywords": [
                "其他", "附件", "支架", "桥架支撑", "预埋件"
            ],
            "name_patterns": [],
            "block_keywords": []
        }
    },

    "cable_identification": {
        "power": {
            "cable_type": "power",
            "priority": 1,
            "keywords": [
                "电缆", "线缆", "电力电缆", "电源线",
                "WDZ", "YJV", "VV", "BV", "BVR", "YJLV",
                "电力", "power", "cable"
            ],
            "model_patterns": [
                "YJV-?\\d{1,3}[×xX*]\\d{1,3}[+]?\\d{1,3}",
                "YJLV-?\\d{1,3}[×xX*]\\d{1,3}",
                "VV-?\\d{1,3}[×xX*]\\d{1,3}",
                "BV-?\\d{1,3}",
                "BVR-?\\d{1,3}",
                "WDZ[NY]-YJV-?\\d{1,3}[×xX*]\\d{1,3}"
            ],
            "colors": ["1", "3", "5", "6", "7"],
            "line_types": ["CONTINUOUS", "DASHED", "CENTER"]
        },
        "control": {
            "cable_type": "control",
            "priority": 2,
            "keywords": [
                "控制电缆", "控制线", "控制线缆",
                "KVV", "KVVP", "RVV",
                "control", "signal"
            ],
            "model_patterns": [
                "KVV-?\\d{1,3}[×xX*]\\d{1,3}",
                "KVVP-?\\d{1,3}[×xX*]\\d{1,3}",
                "RVV-?\\d{1,3}[×xX*]\\d{1,3}"
            ],
            "colors": ["2", "4", "7"],
            "line_types": ["DASHED", "PHANTOM"]
        },
        "signal": {
            "cable_type": "signal",
            "priority": 3,
            "keywords": [
                "信号电缆", "信号线", "通信线",
                "网线", "光缆", "光纤",
                "UTP", "STP", "Cat5", "Cat6", "Cat7"
            ],
            "model_patterns": [],
            "colors": ["4", "6"],
            "line_types": ["PHANTOM", "DASHED"]
        },
        "communication": {
            "cable_type": "communication",
            "priority": 3,
            "keywords": [
                "通信电缆", "电话线", "电视线",
                "RJ45", "RJ11",
                "Cat", "UTP", "FTP"
            ],
            "model_patterns": [],
            "colors": ["6", "4"],
            "line_types": ["DASHED", "DOTTED"]
        }
    },

    "trunking_identification": {
        "trunking": {
            "priority": 1,
            "keywords": [
                "桥架", "电缆桥架", "线槽", "金属线槽",
                "梯式桥架", "槽式桥架", "托盘桥架",
                "CT", "CT-", "TR",
                "Cable Tray", "Cable Trunking", "Trunking"
            ],
            "layer_keywords": [
                "桥架", "线槽", "CT", "TR", "Tray", "trunking"
            ],
            "line_types": ["CONTINUOUS", "DASHED"],
            "colors": ["3", "5", "7"]
        },
        "pipe": {
            "priority": 2,
            "keywords": [
                "配管", "电线管", "镀锌管", "钢管", "PVC管",
                "SC", "PC", "MT", "JDG", "KBG",
                "Pipe", "Tube", "Conduit"
            ],
            "layer_keywords": [
                "配管", "线管", "管路", "SC", "PC", "pipe", "conduit"
            ],
            "line_types": ["DASHED", "CENTER"],
            "colors": ["1", "3", "7"]
        }
    },

    "layer_filter": {
        "enabled": true,
        "description": "电气图层识别规则 - 用于过滤无关图层",

        "electrical_layers": {
            "description": "电气专业图层",
            "keywords": [
                "电气", "电", "ELE", "ELECTRIC", "EL",
                "E", "EE", "EP", "EA", "EM",
                "动力", "照明", "弱电", "配电",
                "POWER", "LIGHT", "SIGNAL",
                "设备", "装置",
                "EQUIP", "DEVICE", "FIXTURE"
            ],
            "layer_prefixes": [
                "E-", "E_", "E/",
                "EL-", "EL_", "EP-", "EP_",
                "电气-", "电气_",
                "A-", "0", "100"
            ]
        },

        "equipment_layers": {
            "description": "设备/装置图层",
            "keywords": [
                "设备", "装置", "柜", "箱", "盘",
                "EQUIP", "DEVICE", "PANEL", "CABINET",
                "PAN", "EQ"
            ],
            "layer_prefixes": [
                "设备", "装置", "柜", "EQ-", "PANEL-"
            ]
        },

        "cable_layers": {
            "description": "线缆图层",
            "keywords": [
                "电缆", "线缆", "电线", "导线",
                "CABLE", "WIRE", "LINE",
                "缆", "线"
            ],
            "layer_prefixes": [
                "电缆", "线缆", "CABLE-", "WIRE-"
            ]
        },

        "trunking_layers": {
            "description": "桥架图层",
            "keywords": [
                "桥架", "线槽",
                "TRAY", "TRUNKING", "CT",
                "CTRAY", "TRNK"
            ],
            "layer_prefixes": [
                "桥架", "线槽", "CT-", "TR-"
            ]
        },

        "pipe_layers": {
            "description": "配管图层",
            "keywords": [
                "配管", "管路", "线管", "管道",
                "PIPE", "CONDUIT", "TUBE",
                "SC", "PC", "MT"
            ],
            "layer_prefixes": [
                "配管", "管路", "PIPE-", "SC-", "PC-"
            ]
        },

        "lighting_layers": {
            "description": "照明图层",
            "keywords": [
                "照明", "灯", "灯具",
                "LIGHT", "LAMP", "FIXTURE", "LG"
            ],
            "layer_prefixes": [
                "照明", "灯", "LIGHT-", "LG-"
            ]
        },

        "annotation_layers": {
            "description": "标注/注释图层",
            "keywords": [
                "标注", "注释", "文字", "说明",
                "NOTE", "TEXT", "DIM", "ANNO",
                "尺寸", "编号"
            ],
            "layer_prefixes": [
                "标注", "注释", "文字", "NOTE-", "TEXT-"
            ]
        },

        "exclude_layers": {
            "description": "需排除的非电气图层",
            "keywords": [
                "建筑", "结构", "给排水", "暖通", "空调",
                "ARCH", "STRUCT", "PLUMB", "HVAC",
                "柱子", "梁", "板", "墙",
                "COLUMN", "BEAM", "WALL", "SLAB",
                "楼梯", "门", "窗",
                "STAIR", "DOOR", "WINDOW",
                "轴线", "轴网", "GRID",
                "尺寸", "DIM", "DIMENSION",
                "标高", "ELEV"
            ],
            "layer_prefixes": [
                "建筑", "结构", "给水", "排水", "暖通",
                "A-", "S-", "P-", "H-", "G-", "D-",
                "AXIS", "GRID"
            ]
        }
    },

    "fuzzy_matching": {
        "enabled": true,
        "description": "模糊匹配参数配置",

        "text_normalization": {
            "remove_spaces": true,
            "remove_special_chars": true,
            "to_lowercase": true,
            "remove_parentheses_content": true,
            "special_chars_to_remove": "()[]{}<>【】（）『』「」『』、\\|.,;:!！？?#@*&^%$"
        },

        "keyword_matching": {
            "exact_match_weight": 1.0,
            "contains_match_weight": 0.8,
            "partial_match_weight": 0.5,
            "min_match_length": 2
        },

        "similarity_threshold": {
            "block_name": 0.6,
            "layer_name": 0.5,
            "text_content": 0.7,
            "cable_model": 0.6
        },

        "multi_keyword_boost": {
            "threshold": 2,
            "boost_factor": 1.3,
            "max_boost": 2.0
        },

        "abbreviation_expansion": {
            "enabled": true,
            "mappings": {
                "P": "配电柜",
                "AP": "动力配电柜",
                "AL": "照明配电箱",
                "ALE": "应急照明配电箱",
                "AT": "双电源切换箱",
                "AA": "高压配电柜",
                "AH": "高压配电柜",
                "M": "电机",
                "K": "开关",
                "L": "灯",
                "E": "应急照明",
                "MCC": "电机控制中心",
                "GGD": "低压配电柜",
                "GCS": "抽出式开关柜",
                "GCK": "抽出式开关柜"
            }
        },

        "chinese_number_conversion": {
            "enabled": true,
            "mappings": {
                "一": "1", "二": "2", "三": "3", "四": "4", "五": "5",
                "六": "6", "七": "7", "八": "8", "九": "9", "十": "10",
                "壹": "1", "贰": "2", "叁": "3", "肆": "4", "伍": "5",
                "陆": "6", "柒": "7", "捌": "8", "玖": "9", "拾": "10"
            }
        }
    },

    "block_extraction_rules": {
        "name_extraction": {
            "from_block_name": true,
            "from_attrib_text": true,
            "from_nearby_text": true,
            "text_search_radius": 500.0,
            "prefer_attrib": true
        },

        "attribute_keys": [
            "NAME", "名称", "型号", "TYPE", "MODEL",
            "TAG", "编号", "TAGNO", "标签",
            "DESC", "说明", "DESCRIPTION",
            "SIZE", "规格", "尺寸"
        ],

        "text_search": {
            "search_radius": 300.0,
            "max_texts_to_check": 10,
            "prefer_below": true,
            "prefer_right": true
        }
    },

    "validation_thresholds": {
        "min_cable_length": 0.1,
        "max_cable_length": 100000.0,
        "min_device_distance": 0.01,
        "max_device_distance": 10000.0,
        "layer_tolerance": 0.001,
        "quantity_tolerance": 0.01,

        "min_confidence_device": 0.3,
        "min_confidence_cable": 0.3,
        "min_confidence_trunking": 0.4,

        "max_devices_per_block": 50,
        "max_cable_groups": 200,
        "max_lines_per_layer": 5000
    },

    "quantity_rules": {
        "device_count": {
            "unit": "个",
            "calculation_method": "count",
            "description": "设备数量统计"
        },
        "cable_length": {
            "unit": "米",
            "calculation_method": "length",
            "include_reserve": true,
            "include_correction": true,
            "description": "线缆长度计算"
        },
        "trunking_length": {
            "unit": "米",
            "calculation_method": "length",
            "include_correction": true,
            "description": "桥架长度计算"
        },
        "pipe_length": {
            "unit": "米",
            "calculation_method": "length",
            "include_correction": true,
            "description": "配管长度计算"
        },
        "accessories": {
            "unit": "个",
            "calculation_method": "derived",
            "base_rule": "device_count",
            "factor": 1.0,
            "description": "辅材数量计算"
        }
    },

