        "lighting": {
            "device_type": "lighting",
            "keywords": ["灯", "照明", "射灯", "吊灯", "应急灯", "指示灯"],
            "priority": 6
        },
        "other": {
            "device_type": "other",
            "keywords": ["其他", "附件", "支架"],
            "priority": 99
        }
    },
    "block_matching": {
        "配电箱": {
            "device_type": "distribution_box",
            "match_type": "exact",
            "quantity_factor": 1.0
        },
        "配电柜": {
            "device_type": "cabinet",
            "match_type": "exact",
            "quantity_factor": 1.0
        },
        "开关": {
            "device_type": "switch",
            "match_type": "contains",
            "quantity_factor": 1.0
        },
        "插座": {
            "device_type": "socket",
            "match_type": "contains",
            "quantity_factor": 1.0
        },
        "灯具": {
            "device_type": "lighting",
            "match_type": "contains",
            "quantity_factor": 1.0
        },
        "电机": {
            "device_type": "equipment",
            "match_type": "contains",
            "quantity_factor": 1.0
        }
    },
    "cable_identification": {
        "by_layer": {
            "电缆": "power",
            "电缆层": "power",
            "线缆": "power",
            "线缆层": "power",
            "控制电缆": "control",
            "信号线": "signal",
            "通信线": "communication"
        },
        "by_color": {
            "1": {"type": "power", "name": "主电缆 (红色)"},
            "3": {"type": "power", "name": "主电缆 (绿色)"},
            "5": {"type": "power", "name": "主电缆 (蓝色)"},
            "2": {"type": "control", "name": "控制电缆 (黄色)"},
            "4": {"type": "signal", "name": "信号电缆 (青色)"},
            "6": {"type": "communication", "name": "通信线 (品红色)"},
            "7": {"type": "power", "name": "通用电缆 (白色)"}
        },
        "by_line_type": {
            "CONTINUOUS": "direct",
            "DASHED": "pipe",
            "PHANTOM": "ceiling",
            "CENTER": "cable_tray"
        }
    },
    "validation_thresholds": {
        "min_cable_length": 0.1,
        "max_cable_length": 10000.0,
        "min_device_distance": 0.01,
        "max_device_distance": 1000.0,
        "layer_tolerance": 0.001,
        "quantity_tolerance": 0.01
    },
    "quantity_rules": {
        "device_count": {
            "unit": "个",
            "calculation_method": "count",
            "description": "设备数量统计"
        },
        "cable_length": {
            "unit": "米",
            "calculation_method": "length",
            "include_reserve": true,
            "include_correction": true,
            "description": "线缆长度计算"
        },
        "trunking_length": {
            "unit": "米",
            "calculation_method": "length",
            "include_correction": true,
            "description": "桥架长度计算"
        },
        "pipe_length": {
            "unit": "米",
            "calculation_method": "length",
            "include_correction": true,
            "description": "配管长度计算"
        },
        "accessories": {
            "unit": "个",
            "calculation_method": "derived",
            "base_rule": "device_count",
            "factor": 1.0,
            "description": "辅材数量计算"
        }
    },
    "layer_mapping": {
        "设备层": ["设备", "装置", "器具", "柜", "箱"],
